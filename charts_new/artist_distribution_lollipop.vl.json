{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Austalian Music Artist Label and Distribution Arrangements",
    "subtitle": "In percentages (%)"
  },
  "width": "container",
  "height": {
    "step": 42
  },
  "data": {
    "values": [
      {
        "arrangement": "No label or distribution support",
        "percentage": 53
      },
      {
        "arrangement": "No label, selected distribution services",
        "percentage": 17
      },
      {
        "arrangement": "Independent label",
        "percentage": 10
      },
      {
        "arrangement": "Own label",
        "percentage": 15
      },
      {
        "arrangement": "Major label",
        "percentage": 2
      },
      {
        "arrangement": "Prefer not to say",
        "percentage": 3
      }
    ]
  },
  "encoding": {
    "y": {
      "field": "arrangement",
      "type": "nominal",
      "sort": "-x",
      "axis": {
        "title": null,
        "labelLimit": 340
      }
    },
    "x": {
      "field": "percentage",
      "type": "quantitative",
      "title": "Respondents (%)",
      "scale": {
        "domain": [
          0,
          60
        ]
      },
      "axis": {
        "grid": true
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#91B59A"
      },
      "encoding": {
        "x": {
          "field": "percentage",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 170,
        "color": "#245746",
        "opacity": 1.0
      },
      "encoding": {
        "x": {
          "field": "percentage",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "arrangement",
            "title": "Arrangement"
          },
          {
            "field": "percentage",
            "title": "Percentage",
            "type": "quantitative",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 9,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "percentage",
          "type": "quantitative"
        },
        "text": {
          "field": "percentage",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelFont": "Inter",
      "titleFont": "Inter",
      "titleFontWeight": 500
    },
    "title": {
      "fontSize": 16,
      "subtitleFontSize": 12,
      "anchor": "start",
      "font": "Inter",
      "fontWeight": 600
    },
    "font": "Inter",
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "text": {
      "font": "Inter"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
