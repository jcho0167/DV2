{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Revenue and export revenue across music subindustries",
    "subtitle": "Bubble size indicates total revenue, while colour hue indiates exports as % of revenue. Revenue is in A$ millions"
  },
  "width": "container",
  "height": 440,
  "data": {
    "values": [
      {
        "subindustry": "Live performance",
        "revenue_2025": 5187,
        "exports_2025": 115,
        "export_revenue_pct_of_revenue": 2.22
      },
      {
        "subindustry": "Music recording",
        "revenue_2025": 821,
        "exports_2025": 510,
        "export_revenue_pct_of_revenue": 62.12
      },
      {
        "subindustry": "Composition, songwriting, etc.",
        "revenue_2025": 488,
        "exports_2025": 124,
        "export_revenue_pct_of_revenue": 25.41
      },
      {
        "subindustry": "Artist management",
        "revenue_2025": 198,
        "exports_2025": 10,
        "export_revenue_pct_of_revenue": 5.05
      },
      {
        "subindustry": "Synchronisation",
        "revenue_2025": 69,
        "exports_2025": 13,
        "export_revenue_pct_of_revenue": 18.84
      },
      {
        "subindustry": "Music retail",
        "revenue_2025": 2803,
        "exports_2025": 274,
        "export_revenue_pct_of_revenue": 9.78
      },
      {
        "subindustry": "Music education",
        "revenue_2025": 1788,
        "exports_2025": 90,
        "export_revenue_pct_of_revenue": 5.03
      }
    ]
  },
  "mark": {
    "type": "circle",
    "opacity": 0.85,
    "stroke": "white",
    "strokeWidth": 1.5
  },
  "encoding": {
    "x": {
      "field": "subindustry",
      "type": "nominal",
      "sort": {
        "field": "revenue_2025",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "labelAngle": -35,
        "labelLimit": 180
      }
    },
    "y": {
      "field": "exports_2025",
      "type": "quantitative",
      "title": "Export revenue in 2025",
      "axis": {
        "grid": true
      }
    },
    "size": {
      "field": "revenue_2025",
      "type": "quantitative",
      "title": "Total revenue",
      "scale": {
        "range": [
          100,
          1800
        ]
      }
    },
    "color": {
      "field": "export_revenue_pct_of_revenue",
      "type": "quantitative",
      "title": "Exports as % of revenue",
      "scale": {
        "range": ["#D5F36A", "#102C25"]
      }
    },
    "tooltip": [
      {
        "field": "subindustry",
        "title": "Subindustry"
      },
      {
        "field": "revenue_2025",
        "title": "Total revenue (A$m)",
        "type": "quantitative",
        "format": ","
      },
      {
        "field": "exports_2025",
        "title": "Export revenue (A$m)",
        "type": "quantitative",
        "format": ","
      },
      {
        "field": "export_revenue_pct_of_revenue",
        "title": "Exports / revenue (%)",
        "type": "quantitative",
        "format": ".2f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelFont": "Inter",
      "titleFont": "Inter",
      "titleFontWeight": 500
    },
    "title": {
      "fontSize": 16,
      "subtitleFontSize": 12,
      "anchor": "start",
      "font": "Inter",
      "fontWeight": 600
    },
    "font": "Inter",
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "text": {
      "font": "Inter"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
