{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Do Australian Muisc Artists Perform ?",
    "subtitle": "Number of performances in thousands"
  },
  "width": "container",
  "height": {
    "step": 28
  },
  "data": {
    "values": [
      {
        "venue": "Hotels and pubs",
        "performances": 17.9
      },
      {
        "venue": "Registered clubs",
        "performances": 5.4
      },
      {
        "venue": "Concert halls and theatres",
        "performances": 8.4
      },
      {
        "venue": "Regional performing arts centres",
        "performances": 3.2
      },
      {
        "venue": "Outdoor public spaces",
        "performances": 5.1
      },
      {
        "venue": "Community centres and halls for hire",
        "performances": 5.9
      },
      {
        "venue": "Nightclubs",
        "performances": 2.4
      },
      {
        "venue": "Arenas",
        "performances": 1.1
      },
      {
        "venue": "Stadiums",
        "performances": 0.2
      },
      {
        "venue": "Private settings",
        "performances": 7.0
      },
      {
        "venue": "Other",
        "performances": 2.4
      }
    ]
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "y": {
      "field": "venue",
      "type": "nominal",
      "sort": "-x",
      "axis": {
        "title": null,
        "labelLimit": 280
      }
    },
    "x": {
      "field": "performances",
      "type": "quantitative",
      "title": "Performances (thousands)",
      "axis": {
        "grid": true
      }
    },
    "color": {
      "condition": {
        "test": "datum.venue == 'Hotels and pubs'",
        "value": "#245746"
      },
      "value": "#56816A"
    },
    "tooltip": [
      {
        "field": "venue",
        "title": "Venue type"
      },
      {
        "field": "performances",
        "title": "Performances (thousands)",
        "type": "quantitative",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelFont": "Inter",
      "titleFont": "Inter",
      "titleFontWeight": 500
    },
    "title": {
      "fontSize": 16,
      "subtitleFontSize": 12,
      "anchor": "start",
      "font": "Inter",
      "fontWeight": 600
    },
    "font": "Inter",
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "text": {
      "font": "Inter"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
