{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map: home towns of Australia's most-awarded ARIA artists, sized by awards won. Click a state to show only its towns.",
  "width": "container",
  "height": 500,
  "projection": {"type": "conicEqualArea", "parallels": [-18, -36], "rotate": [-134, 0]},
  "layer": [
    {
      "data": {"url": "data/au-states.geojson", "format": {"type": "json", "property": "features"}},
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "data/states.csv",
              "format": {"type": "csv", "parse": {"artists": "number", "wins": "number"}}
            },
            "key": "state_name",
            "fields": ["state", "artists", "wins"]
          }
        }
      ],
      "params": [{"name": "pickState", "select": {"type": "point", "fields": ["state"]}}],
      "mark": {"type": "geoshape", "stroke": "#f7f6f0", "strokeWidth": 1.5, "cursor": "pointer"},
      "encoding": {
        "color": {
          "condition": {"param": "pickState", "empty": false, "value": "#cfccbf"},
          "value": "#e3e1d6"
        },
        "tooltip": [
          {"field": "properties.STATE_NAME", "title": "State"},
          {"field": "artists", "title": "Most-awarded artists from here"},
          {"field": "wins", "title": "ARIA Awards won"}
        ]
      }
    },
    {
      "data": {
        "url": "data/aria_places.csv",
        "format": {
          "type": "csv",
          "parse": {"lat": "number", "lon": "number", "artists": "number", "wins": "number"}
        }
      },
      "mark": {"type": "circle", "stroke": "#8c6400", "strokeWidth": 1.2},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "wins",
          "type": "quantitative",
          "title": "ARIA Awards won",
          "scale": {"range": [60, 2600]},
          "legend": {
            "orient": "bottom-left",
            "direction": "horizontal",
            "values": [10, 50, 100],
            "symbolFillColor": "rgba(181, 130, 0, 0.5)",
            "symbolStrokeWidth": 1.2,
            "symbolStrokeColor": "#8c6400",
            "symbolOpacity": 1
          }
        },
        "color": {"value": "#b58200"},
        "tooltip": [
          {"field": "place", "title": "Home town"},
          {"field": "state", "title": "State"},
          {"field": "artists", "title": "Artists"},
          {"field": "wins", "title": "ARIA Awards won"},
          {"field": "names", "title": "Who"}
        ],
        "fillOpacity": {"condition": {"param": "pickState", "empty": true, "value": 0.5}, "value": 0.06},
        "strokeOpacity": {"condition": {"param": "pickState", "empty": true, "value": 0.95}, "value": 0.15}
      }
    },
    {
      "data": {
        "url": "data/aria_places.csv",
        "format": {
          "type": "csv",
          "parse": {"lat": "number", "lon": "number", "artists": "number", "wins": "number"}
        }
      },
      "transform": [{"filter": "datum.wins >= 40"}],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 26,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#17221b"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "place"}
      }
    },
    {
      "data": {
        "values": [
          {"lon": 133.2, "lat": -9.6, "t": "Arnhem Land: Yothu Yindi,"},
          {"lon": 133.2, "lat": -10.4, "t": "Gurrumul and Baker Boy"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 11.5,
        "fontStyle": "italic",
        "color": "#5e675f"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "t"}
      }
    }
  ]
}
