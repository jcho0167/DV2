{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top 5 Australian Music Artists",
    "subtitle": "Chart is in millions of monthly Spotify listeners"
  },
  "width": "container",
  "height": 360,
  "data": {
    "values": [
      {
        "artist": "Sia",
        "listeners": 69.7,
        "image": "https://i.scdn.co/image/ab6761610000e5ebcc1806f0a2f6c9e449de9d3c"
      },
      {
        "artist": "Tame Impala",
        "listeners": 61.1,
        "image": "https://i.scdn.co/image/ab6761610000e5ebe412a782245eb20d9626c601"
      },
      {
        "artist": "The Kid LAROI",
        "listeners": 40.2,
        "image": "https://i.scdn.co/image/ab6761610000e5eb1cea74b0fa7d098d5e80cd87"
      },
      {
        "artist": "Empire Of The Sun",
        "listeners": 38.3,
        "image": "https://i.scdn.co/image/ab6761610000e5ebc806f3e714afa21861e20248"
      },
      {
        "artist": "AC/DC",
        "listeners": 37.7,
        "image": "https://i.scdn.co/image/ab6761610000e5ebc4c77549095c86acb4e77b37"
      }
    ]
  },
  "mark": {
    "type": "image",
    "width": 76,
    "height": 76,
    "aspect": true
  },
  "encoding": {
    "x": {
      "field": "artist",
      "type": "nominal",
      "sort": "-y",
      "axis": {
        "title": "Artist",
        "labelAngle": 0,
        "labelLimit": 150
      }
    },
    "y": {
      "field": "listeners",
      "type": "quantitative",
      "axis": {
        "title": "Monthly Spotify Listeners",
        "grid": true
      },
      "scale": {
        "zero": true,
        "nice": true
      }
    },
    "url": {
      "field": "image",
      "type": "nominal"
    },
    "tooltip": [
      {
        "field": "artist",
        "type": "nominal",
        "title": "Artist"
      },
      {
        "field": "listeners",
        "type": "quantitative",
        "title": "Listeners",
        "format": ","
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "labelFontSize": 12,
      "titleFont": "Inter",
      "titleFontSize": 13,
      "titleFontWeight": 500
    },
    "title": {
      "font": "Inter",
      "fontSize": 18,
      "fontWeight": 600,
      "anchor": "start"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    },
    "text": {
      "font": "Inter"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
