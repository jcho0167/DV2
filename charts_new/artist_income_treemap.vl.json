  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              600
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              360
            ],
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "y2"
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Live performances",
              "Royalties",
              "Other",
              "Teaching fees",
              "Session fees"
            ],
            "range": [
              "#074a34",
              "#245746",
              "#56816A",
              "#91B59A",
              "#D5F36A"
            ]
          }
        },
        "tooltip": [
          {
            "field": "category",
            "title": "Income source"
          },
          {
            "field": "value",
            "title": "Income (A$m)",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "lineBreak": "\n",
        "limit": 130
      },
      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              600
            ]
          },
          "axis": null
        },
        "y": {
          "field": "cy",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              360
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "label"
        },
        "color": {
          "value": "#17202A"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelFont": "Inter",
      "titleFont": "Inter",
      "titleFontWeight": 500
    },
    "title": {
      "fontSize": 16,
      "subtitleFontSize": 12,
      "anchor": "start",
      "font": "Inter",
      "fontWeight": 600
    },
    "font": "Inter",
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "text": {
      "font": "Inter"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
